# ──────────────────────────────────────────────────────────────
#  Gamora — variáveis de ambiente (MODELO, sem valores reais)
#  Copie para .env e preencha:   cp .env.example .env
#  O arquivo .env está no .gitignore e nunca vai para o GitHub.
#
#  REGRA DE OURO
#  • VITE_*  → vai para o navegador. Só valores PÚBLICOS.
#  • Sem VITE_ → só servidor (Vercel Functions em /api). Segredos aqui.
# ──────────────────────────────────────────────────────────────

# ── App
VITE_APP_NAME=Gamora
VITE_APP_URL=http://localhost:5173

# Origem dos dados: "local" (mocks + localStorage) | "supabase"
VITE_DATA_SOURCE=local

# Estágio na interface: 1 = app nativo · 2 = + Fatura e Assistente
VITE_APP_STAGE=2

# ── Supabase (público — protegido por RLS)
# Painel Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sua-chave-publica

# ── Supabase (SECRETO — só servidor, nunca com VITE_)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Estágio 2 · OpenAI (SECRETO — só servidor, nunca com VITE_)
# platform.openai.com → API keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# true = Fatura/Assistente chamam a OpenAI via /api · false = respostas simuladas
VITE_FEATURE_AI=false
VITE_API_BASE_URL=/api

# ── Prisma (opcional, SÓ no servidor) ────────────────────────────────
# Documentação do banco em prisma/schema.prisma. A conexão do Prisma usa o papel
# postgres e IGNORA o RLS: toda consulta precisa filtrar por user_id.
# Supabase → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
